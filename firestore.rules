rules_version = '2';

// Crumb security rules.
// Every user can read and write only their own documents under /users/{uid}.
// Server-only collections (tokens, rate limits, ingest tokens) are closed to clients;
// the Cloud Run API reaches them with the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isMealType(value) {
      return value in ['breakfast', 'lunch', 'dinner', 'snack'];
    }

    function validProfile(p) {
      return p.keys().hasAll(['age', 'sex', 'heightCm', 'weightKg', 'activityLevel', 'goal'])
        && p.age is int && p.age >= 18 && p.age <= 110
        && p.sex in ['male', 'female', 'other']
        && p.heightCm is number && p.heightCm >= 100 && p.heightCm <= 250
        && p.weightKg is number && p.weightKg >= 30 && p.weightKg <= 300
        && p.activityLevel in ['sedentary', 'light', 'moderate', 'very_active']
        && p.goal in ['lose_fat', 'gain_muscle', 'maintain', 'improve_fitness', 'general_health'];
    }

    function validUser(d) {
      return d.keys().hasOnly(['profile', 'targets', 'settings', 'createdAt', 'updatedAt'])
        && (!('profile' in d) || validProfile(d.profile));
    }

    function validEntry(e) {
      return e.keys().hasOnly([
          'date', 'loggedAt', 'mealType', 'inputType', 'rawInput', 'thumb', 'status',
          'items', 'totals', 'aiModel', 'templateId', 'createdAt', 'updatedAt'
        ])
        && isDateKey(e.date)
        && isMealType(e.mealType)
        && e.inputType in ['photo', 'text', 'voice', 'manual', 'quick']
        && e.status in ['confirmed', 'pending_ai']
        && e.items is list && e.items.size() <= 30
        && (!('rawInput' in e) || (e.rawInput is string && e.rawInput.size() <= 1000))
        && (!('thumb' in e) || (e.thumb is string && e.thumb.size() <= 40000));
    }

    function validActivity(a) {
      return a.keys().hasOnly([
          'date', 'startedAt', 'type', 'label', 'durationMin', 'distanceKm', 'steps', 'kcal',
          'range', 'met', 'intensity', 'source', 'confidence', 'externalId', 'createdAt', 'updatedAt'
        ])
        && isDateKey(a.date)
        && a.source == 'manual'
        && a.kcal is number && a.kcal >= 0 && a.kcal <= 5000
        && (!('steps' in a) || (a.steps is int && a.steps >= 0 && a.steps <= 150000))
        && (!('durationMin' in a) || (a.durationMin is number && a.durationMin >= 0 && a.durationMin <= 1440));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry(request.resource.data);
      }

      match /activities/{activityId} {
        allow read, delete: if isOwner(uid);
        // Clients may only create or edit manual activities; synced ones are written by the server.
        allow create: if isOwner(uid) && validActivity(request.resource.data);
        allow update: if isOwner(uid) && resource.data.source == 'manual'
          && validActivity(request.resource.data);
      }

      match /days/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDateKey(date)
          && request.resource.data.keys().size() <= 24;
      }

      match /memory/{key} {
        allow read, write: if isOwner(uid);
      }

      match /meals/{templateId} {
        allow read, write: if isOwner(uid);
      }

      match /corrections/{correctionId} {
        allow read, create, delete: if isOwner(uid);
      }

      match /insights/{key} {
        allow read, write: if isOwner(uid);
      }

      match /integrations/{provider} {
        allow read: if isOwner(uid);
      }
    }

    match /private/{document=**} {
      allow read, write: if false;
    }

    match /rateLimits/{document=**} {
      allow read, write: if false;
    }

    match /ingestTokens/{document=**} {
      allow read, write: if false;
    }
  }
}
