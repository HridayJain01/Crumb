# Copy to apps/api/.env for local overrides (gitignored). Values here override .env.development.

# Use real Gemini locally with a free AI Studio key (synthetic data only — free-tier
# prompts may be used by Google to improve products):
# MOCK_EXTERNALS=false
# AI_PROVIDER=gemini-api
# GEMINI_API_KEY=...

# Or Vertex AI with your gcloud application-default credentials:
# MOCK_EXTERNALS=false
# AI_PROVIDER=vertex
# VERTEX_PROJECT=your-project-id
# VERTEX_LOCATION=global

# Model routing (confirm current IDs in Vertex Model Garden / AI Studio):
# AI_MODEL_TEXT=gemini-3.5-flash-lite
# AI_MODEL_VISION=gemini-3.6-flash
# AI_FALLBACK_MODELS=gemini-3.5-flash

# Optional integrations
# MAPS_SERVER_KEY=...            # Routes API only
# GOOGLE_HEALTH_CLIENT_ID=...
# GOOGLE_HEALTH_CLIENT_SECRET=...
# TOKEN_ENC_KEY=...              # openssl rand -base64 32
# STATE_HMAC_KEY=...             # openssl rand -base64 32
