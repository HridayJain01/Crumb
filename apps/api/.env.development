# Local development defaults (no secrets). Put overrides, e.g. a GEMINI_API_KEY, in apps/api/.env
PORT=8787
NODE_ENV=development
MOCK_EXTERNALS=true
FIREBASE_PROJECT_ID=demo-crumb
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PUBLIC_APP_URL=http://localhost:5173
# Not on Google Cloud locally: skip the metadata-server probe (silences a harmless warning).
METADATA_SERVER_DETECTION=none
