# Local development against the Firebase Emulator Suite (no cloud project needed).
# Safe to commit: demo-* projects only exist inside the emulators.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-crumb
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_APP_ID=demo-crumb-web
# Optional: a Maps Embed API browser key (referrer-restricted) for route previews.
VITE_MAPS_EMBED_KEY=
