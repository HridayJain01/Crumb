# Copy to apps/web/.env.production.local and fill in from Firebase console → Project settings → Web app.
# The Firebase web config is public by design; access is enforced by Auth + Firestore rules.
VITE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=your-web-api-key
# Use your Hosting domain so sign-in popups stay first-party.
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.web.app
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Browser key restricted to the Maps Embed API and your Hosting domains (free, unlimited).
VITE_MAPS_EMBED_KEY=
